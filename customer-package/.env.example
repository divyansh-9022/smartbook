# ============================================================
# SmartBook Configuration
# Copy this file to .env and fill in all values.
# NEVER share your .env file.
# ============================================================

# Database
SMARTBOOK_DB_NAME=smartbook_db
SMARTBOOK_DB_USERNAME=smartbook_app
SMARTBOOK_DB_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
SMARTBOOK_DB_ROOT_PASSWORD=CHANGE_THIS_TO_A_STRONG_ROOT_PASSWORD

# Security
# Generate with: openssl rand -base64 48
SMARTBOOK_JWT_SECRET=GENERATE_A_STRONG_SECRET_AT_LEAST_32_CHARS

# Email (SMTP configuration)
# Use a Gmail App Password, not your regular Gmail password.
# https://support.google.com/accounts/answer/185833
# SMTP Email Configuration (Required)
# Each customer must provide their own SMTP credentials.
SMARTBOOK_MAIL_HOST=smtp.gmail.com
SMARTBOOK_MAIL_PORT=587
SMARTBOOK_MAIL_USERNAME=your-email@gmail.com
SMARTBOOK_MAIL_PASSWORD=YOUR_SMTP_APP_PASSWORD
SMARTBOOK_MAIL_FROM=your-email@gmail.com

# Gumroad licence key (provided in your purchase receipt)
GUMROAD_PRODUCT_ID=aencmOQnsl3-yPgc5SAPcA==

# URL where SmartBook will be accessed
# For local use: http://localhost:8082
# For a server: https://your-domain.example
FRONTEND_URL=http://localhost:8082
